{
  "name": "ledgerlab",
  "version": "0.1.0",
  "private": true,
  "description": "Technical test scaffold: accounting SaaS with a dashboard, a double-entry ledger service, and a reporting service.",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ai:log": "node scripts/log-ai-prompt.mjs",
    "ai:verify": "node scripts/verify-ai-log.mjs",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @ledgerlab/db migrate:sql",
    "db:seed": "pnpm --filter @ledgerlab/db seed",
    "docker:build": "docker build -f deployment/Dockerfile.ledger-api -t ledgerlab/ledger-api . && docker build -f deployment/Dockerfile.reporting-api -t ledgerlab/reporting-api . && docker build -f deployment/Dockerfile.web -t ledgerlab/web .",
    "guide:pdf": "node scripts/build-guide.mjs",
    "guide:html": "node scripts/build-guide.mjs --html-only",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "marked": "^18.0.14",
    "prettier": "^3.4.2",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3"
  }
}
