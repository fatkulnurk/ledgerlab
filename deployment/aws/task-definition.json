{
  "family": "ledgerlab-ledger-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": { "cpuArchitecture": "X86_64", "operatingSystemFamily": "LINUX" },
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ledgerlabTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ledgerlabTaskRole",
  "containerDefinitions": [
    {
      "name": "ledger-api",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/ledgerlab/ledger-api:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 4001, "protocol": "tcp" }],
      "environment": [
        { "name": "LEDGER_API_PORT", "value": "4001" },
        { "name": "NODE_ENV", "value": "production" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ledgerlab/DATABASE_URL" },
        { "name": "INTERNAL_API_TOKEN", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/ledgerlab/INTERNAL_API_TOKEN" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://127.0.0.1:4001/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ledgerlab-ledger-api",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
