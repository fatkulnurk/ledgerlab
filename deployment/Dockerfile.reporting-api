# syntax=docker/dockerfile:1
# Reporting API image. Build from the REPO ROOT:
#   docker build -f deployment/Dockerfile.reporting-api -t ledgerlab/reporting-api .
FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/reporting-api/package.json ./apps/reporting-api/
RUN pnpm install --frozen-lockfile --prod=false --ignore-scripts=false

COPY packages/shared ./packages/shared
COPY apps/reporting-api ./apps/reporting-api
RUN pnpm --filter @ledgerlab/reporting-api build

FROM node:20-alpine AS runner
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production CI=true

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/reporting-api/package.json ./apps/reporting-api/
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

COPY --from=builder /app/apps/reporting-api/dist ./apps/reporting-api/dist

USER node
# No port default here: the platform sets PORT and local dev sets REPORTING_API_PORT.
ENV REPORTING_API_HOST=0.0.0.0
EXPOSE 4002
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.REPORTING_API_PORT||process.env.PORT||4002)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/reporting-api/dist/index.js"]
