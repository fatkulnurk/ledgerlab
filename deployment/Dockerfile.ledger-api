# syntax=docker/dockerfile:1
# Ledger API image. Build from the REPO ROOT:
#   docker build -f deployment/Dockerfile.ledger-api -t ledgerlab/ledger-api .
FROM node:20-alpine AS builder
RUN corepack enable
WORKDIR /app

# Copy manifests first so dependency layers cache well.
COPY pnpm-workspace.yaml package.json tsconfig.base.json turbo.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/db/package.json ./packages/db/
COPY apps/ledger-api/package.json ./apps/ledger-api/
RUN pnpm install --prod=false --ignore-scripts=false

COPY packages ./packages
COPY apps/ledger-api ./apps/ledger-api
RUN pnpm --filter @ledgerlab/ledger-api build

FROM node:20-alpine AS runner
RUN corepack enable
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app ./
RUN pnpm prune --prod --ignore-scripts || true

# Run as a non-root user.
USER node
ENV LEDGER_API_PORT=4001 LEDGER_API_HOST=0.0.0.0
EXPOSE 4001
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.LEDGER_API_PORT||4001)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/ledger-api/dist/index.js"]
