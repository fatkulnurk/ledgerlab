# ---------------------------------------------------------------------------
# LedgerLab environment template. Copy to `.env` for local development.
#   cp .env.example .env
# Every value below is READ BY THE APPS. Nothing here is secret for local dev.
# ---------------------------------------------------------------------------

# --- Ledger API ------------------------------------------------------------
LEDGER_API_PORT=4001
LEDGER_API_HOST=0.0.0.0
# Allowed browser origins (comma separated). Use * only for local dev.
# In production this MUST be the real dashboard origin — "*" refuses to boot.
CORS_ORIGINS=http://localhost:5173
# Shared secret guarding /api/internal/*. Required in production.
# INTERNAL_API_TOKEN=change-me
# Rate limit for /api/* (defaults: 120 requests per 60s per client IP).
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
# Entries dated on or before this ISO date are rejected (closed period).
# Leave unset to keep every period open.
# CLOSED_THROUGH=2026-06-30

# --- Reporting API ---------------------------------------------------------
REPORTING_API_PORT=4002
REPORTING_API_HOST=0.0.0.0
# Reporting is a separate service and talks to the ledger over HTTP.
LEDGER_API_URL=http://localhost:4001
# Same rate limit knobs as the ledger API.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_WINDOW_MS=60000

# --- Web dashboard ---------------------------------------------------------
# Vite exposes only VITE_* vars to the browser bundle.
VITE_LEDGER_API_URL=http://localhost:4001
VITE_REPORTING_API_URL=http://localhost:4002

# --- Database (OPTIONAL) ---------------------------------------------------
# Leave DATABASE_URL UNSET to run on the built-in in-memory repository (seeded
# demo data, resets on restart). Set it to use Postgres via Drizzle.
# DATABASE_URL=postgres://ledgerlab:ledgerlab@localhost:5432/ledgerlab
# Connection pool (only used with DATABASE_URL).
# DB_POOL_MAX=10
# DB_IDLE_TIMEOUT_SECONDS=30
